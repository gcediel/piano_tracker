<%- include('partials/header') %>

<% if (mensaje) { %><div class="alert alert-success"><%- mensaje %></div><% } %>
<% if (error)   { %><div class="alert alert-danger"><%- error %></div><% } %>

<div class="card">
  <h2><%= ejercicioEditar ? 'Editar ejercicio' : 'Añadir ejercicio de técnica' %></h2>
  <form method="POST" action="/tecnica">
    <input type="hidden" name="accion" value="<%= ejercicioEditar ? 'editar' : 'crear' %>">
    <% if (ejercicioEditar) { %><input type="hidden" name="id" value="<%= ejercicioEditar.id %>"><% } %>

    <div class="form-inline">
      <div class="form-group">
        <label for="nombre">Nombre del ejercicio *</label>
        <input type="text" id="nombre" name="nombre" required style="width:100%;max-width:500px;"
               value="<%= ejercicioEditar ? ejercicioEditar.nombre : '' %>">
      </div>
      <div class="form-group">
        <label for="bpm">BPM inicial</label>
        <input type="number" id="bpm" name="bpm" min="20" max="300" style="width:80px;"
               value="<%= ejercicioEditar ? ejercicioEditar.bpm : 120 %>">
      </div>
    </div>

    <div class="form-group">
      <label for="comentarios">Comentarios</label>
      <textarea id="comentarios" name="comentarios" rows="2" style="width:100%;max-width:600px;"><%= ejercicioEditar ? (ejercicioEditar.comentarios || '') : '' %></textarea>
    </div>

    <div class="mt-1">
      <button type="submit" class="btn btn-success"><%= ejercicioEditar ? '💾 Guardar cambios' : '➕ Añadir ejercicio' %></button>
      <% if (ejercicioEditar) { %><a href="/tecnica" class="btn btn-primary">Cancelar</a><% } %>
    </div>
  </form>
</div>

<% if (!ejercicios.length) { %>
<div class="card">
  <p style="text-align:center;color:var(--gray);">No hay ejercicios definidos todavía. Añade el primero con el formulario anterior.</p>
</div>
<% } else { %>

<div class="card">
  <h2>Ejercicios de técnica (<%= ejercicios.length %>)</h2>
  <div style="overflow-x:auto;">
  <table id="tablaEjercicios" class="display" style="width:100%">
    <thead>
      <tr><th>Nombre</th><th title="Orden en el que se elegirán en la próxima sesión de técnica por ejercicios">Próx. práctica</th><th>BPM actual</th><th>Prácticas</th><th>Comentarios</th><th>Estado</th><th>Acciones</th></tr>
    </thead>
    <tbody>
    <% ejercicios.forEach(ej => { %>
      <tr style="opacity:<%= ej.activo ? '1' : '0.5' %>;">
        <td><%= ej.nombre %></td>
        <td data-order="<%= ordenProximaPractica[ej.id] || 9999 %>" style="text-align:center;">
          <%= ej.activo ? ordenProximaPractica[ej.id] : '—' %>
        </td>
        <td data-order="<%= ej.bpm %>" style="text-align:center;"><strong>♩ = <%= ej.bpm %></strong></td>
        <td style="text-align:center;"><%= ej.num_reproducciones %></td>
        <td style="font-size:0.85rem;color:var(--gray);"><%= ej.comentarios || '' %></td>
        <td style="text-align:center;">
          <% if (ej.activo) { %><span style="color:var(--success);">Activo</span><% } else { %><span style="color:var(--gray);">Inactivo</span><% } %>
        </td>
        <td style="white-space:nowrap;">
          <a href="/tecnica?editar=<%= ej.id %>" class="btn btn-small btn-primary">Editar</a>
          <form method="POST" action="/tecnica" style="display:inline;" data-confirm="¿Resetear BPM a 120 y borrar todas las prácticas de este ejercicio?">
            <input type="hidden" name="id" value="<%= ej.id %>">
            <input type="hidden" name="accion" value="resetear_bpm">
            <button type="submit" class="btn btn-small btn-primary">↺ 120</button>
          </form>
          <form method="POST" action="/tecnica" style="display:inline;">
            <input type="hidden" name="id" value="<%= ej.id %>">
            <% if (ej.activo) { %>
              <input type="hidden" name="accion" value="desactivar">
              <button type="submit" class="btn btn-small btn-warning">Desactivar</button>
            <% } else { %>
              <input type="hidden" name="accion" value="activar">
              <button type="submit" class="btn btn-small btn-success">Activar</button>
            <% } %>
          </form>
          <form method="POST" action="/tecnica" style="display:inline;" data-confirm="¿Eliminar este ejercicio?">
            <input type="hidden" name="accion" value="eliminar">
            <input type="hidden" name="id" value="<%= ej.id %>">
            <button type="submit" class="btn btn-small btn-danger">Eliminar</button>
          </form>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
</div>

<% } %>

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css">
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script>
$(document).ready(function() {
  if ($('#tablaEjercicios tbody tr').length > 1) {
    $('#tablaEjercicios').DataTable({
      language: { url: '//cdn.datatables.net/plug-ins/1.13.8/i18n/es-ES.json' },
      pageLength: 25,
      order: [[1, 'asc']], // columna "Próx. práctica"
      columnDefs: [ { orderable: false, targets: -1 } ]
    });
  }
});
</script>

<%- include('partials/footer') %>
