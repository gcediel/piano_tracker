<%- include('partials/header') %>

<div class="card">
  <h2>📅 <%= textos.titulo %></h2>

  <% if (resumen.tiempo.dias === 0) { %>
    <p><%= textos.sinPractica %></p>
  <% } else { %>
  <div class="stats-grid">
    <div class="stat-box">
      <h3><%= h.formatearTiempo(resumen.tiempo.segundos) %></h3>
      <p>Tiempo practicado</p>
      <%- h.compararTexto(resumen.tiempo.segundos, resumen.tiempoPrevio.segundos, textos) %>
    </div>
    <div class="stat-box">
      <h3><%= resumen.tiempo.dias %>/<%= resumen.diasPeriodo %> días</h3>
      <p>Días practicados</p>
      <%- h.compararTexto(resumen.tiempo.dias, resumen.tiempoPrevio.dias, textos) %>
    </div>
    <div class="stat-box">
      <h3>🏅 <%= resumen.puntuacion.total.toFixed(1) %></h3>
      <p><%= resumen.puntuacion.piezas %> piezas puntuadas</p>
      <% if (resumen.puntuacionPrevia.piezas === 0) { %>
        <small style="opacity:0.7;">(sin datos suficientes <%= textos.pasado %>)</small>
      <% } else if (Math.abs(resumen.puntuacionDiff) < 0.05) { %>
        <small style="opacity:0.7;">(igual que <%= textos.anterior %>)</small>
      <% } else { %>
        <small style="opacity:0.7;">(<%= resumen.puntuacionDiff > 0 ? '+' : '' %><%= resumen.puntuacionDiff.toFixed(1) %> vs. <%= textos.vs %>)</small>
      <% } %>
    </div>
  </div>
  <% } %>
</div>

<% if (resumen.periodoFlojo) { %>
<div class="alert alert-info">
  📉 <%= textos.flojo %>
</div>
<% } %>

<% if (resumen.logroPieza) { %>
<div class="alert alert-success">
  🏆 <strong><%= textos.logro %>:</strong>
  <%= resumen.logroPieza.pieza.compositor %> - <%= resumen.logroPieza.pieza.titulo %>
  bajó su media de fallos de <strong><%= resumen.logroPieza.mediaAnterior.toFixed(2) %></strong>
  a <strong><%= resumen.logroPieza.mediaActual.toFixed(2) %></strong> por pase.
</div>
<% } %>

<% if (resumen.mejoras.length > 1) { %>
<div class="card">
  <h2>🎹 Piezas con mejora <%= textos.este %></h2>
  <table>
    <thead>
      <tr><th>Pieza</th><th>Media de fallos (<%= textos.vs %>)</th><th>Media de fallos (<%= textos.este %>)</th></tr>
    </thead>
    <tbody>
      <% resumen.mejoras.forEach(m => { %>
      <tr>
        <td><%= m.pieza.compositor %> - <%= m.pieza.titulo %></td>
        <td><%= m.mediaAnterior.toFixed(2) %></td>
        <td><strong><%= m.mediaActual.toFixed(2) %></strong></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<% if (resumen.piezasNuevas.length) { %>
<div class="card">
  <h2>✨ Piezas nuevas en el repertorio</h2>
  <ul>
    <% resumen.piezasNuevas.forEach(p => { %>
      <li><%= p.compositor %> - <%= p.titulo %></li>
    <% }) %>
  </ul>
</div>
<% } %>

<% if (resumen.avisosProgresion.length) { %>
<div class="card">
  <h2>📈 Progresión</h2>
  <ul>
    <% resumen.avisosProgresion.forEach(a => { %>
      <% if (a.sugerencia_tempo_pendiente !== null) { %>
        <li>🎹 <%= a.compositor %> - <%= a.titulo %>: sugerencia de subir tempo de <%= a.tempo %> a <strong><%= a.sugerencia_tempo_pendiente %> BPM</strong> pendiente de confirmar en el dashboard.</li>
      <% } %>
      <% if (a.aviso_graduacion_pendiente) { %>
        <li>🛠 <%= a.compositor %> - <%= a.titulo %>: pasó a repertorio de mantenimiento.</li>
      <% } %>
    <% }) %>
  </ul>
</div>
<% } %>

<% if (resumen.tecnica.total > 0) { %>
<div class="card">
  <h2>🛠 Técnica</h2>
  <p>
    <%= resumen.tecnica.ejerciciosDistintos %> ejercicios distintos trabajados
    (<%= resumen.tecnica.bien %> con resultado "bien" de <%= resumen.tecnica.total %> valoraciones).
    BPM medio practicado: <strong><%= Math.round(resumen.tecnica.bpmMedio) %></strong>
    <% if (resumen.tecnica.bpmMedioPrevio != null) { %>
      <%- h.compararTexto(resumen.tecnica.bpmMedio, resumen.tecnica.bpmMedioPrevio, textos) %>
    <% } %>
  </p>
</div>
<% } %>

<div class="card" style="text-align:center; display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;">
  <% if (textos.informeUrl) { %>
    <a href="<%= textos.informeUrl %>" class="btn btn-primary"><%= textos.informeTexto %></a>
  <% } %>
  <a href="/resumen?periodo=<%= resumen.periodo %>&continuar=1" class="btn btn-success">Empezar a practicar →</a>
</div>

<%- include('partials/footer') %>
