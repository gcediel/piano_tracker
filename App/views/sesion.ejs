<%- include('partials/header') %>

<% if (mensaje) { %><div class="alert alert-success"><%- mensaje %></div><% } %>
<% if (error)   { %><div class="alert alert-danger"><%- error %></div><% } %>

<!-- ══════════════════════════ VER DETALLES ══════════════════════════ -->
<% if (sesionVer) { %>
<div class="card">
  <h2>Detalles de sesión — <%= h.formatDate(sesionVer.fecha) %></h2>
  <p><strong>Estado:</strong> <%= sesionVer.estado.charAt(0).toUpperCase() + sesionVer.estado.slice(1) %></p>
  <% if (actividadesVer && actividadesVer.length) { %>
  <table>
    <thead><tr><th>Actividad</th><th>Descripción</th><th>Tiempo</th><th>Estado</th></tr></thead>
    <tbody>
    <% actividadesVer.forEach(act => { %>
      <tr>
        <td><%= h.getNombreActividad(act.tipo) %></td>
        <td>
          <% if (act.tipo === 'repertorio' && act.compositor) { %>
            <strong>🎹 <%= act.compositor %> — <%= act.titulo %><% if (act.tempo) { %> (♩ = <%= act.tempo %>)<% } %></strong>
            <% if (act.notas) { %><br><small><%- act.notas.replace(/\n/g,'<br>') %></small><% } %>
          <% } else { %>
            <%= act.notas || '-' %>
          <% } %>
        </td>
        <td><%= h.formatearTiempo(act.tiempo_segundos) %></td>
        <td><%= act.estado.charAt(0).toUpperCase() + act.estado.slice(1) %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  <% } %>
  <a href="/sesion" class="btn btn-primary mt-1">Volver</a>
</div>

<!-- ══════════════════════════ SESIÓN ACTIVA ══════════════════════════ -->
<% } else if (sesion) { %>
<div class="card">
  <h2>Sesión en curso — <%= h.formatDate(sesion.fecha) %></h2>
  <% if (actividadActual) { %>
  <div class="timer-display" id="timerDisplay">
    <div class="actividad-actual" id="infoActividad">
      <strong><%= h.getNombreActividad(actividadActual.tipo) %></strong>
      <span id="piezaActualInfo">
        <% if (actividadActual.compositor) { %>
          <br><small><%= actividadActual.compositor %> — <%= actividadActual.titulo %><% if (actividadActual.tempo) { %> (♩ = <%= actividadActual.tempo %>)<% } %></small>
        <% } %>
      </span>
      <% if (actividadActual.notas) { %>
        <br><small id="notasActuales"><%- actividadActual.notas.replace(/\n/g,'<br>') %></small>
      <% } %>
      <br>
      <div style="margin-top:0.5rem;">
        <input type="text" id="notasActividad" placeholder="Añadir/editar notas…" value="<%= actividadActual.notas || '' %>" style="width:100%;max-width:500px;padding:0.4rem;border-radius:4px;">
        <button onclick="guardarNotas()" class="btn btn-small btn-primary" style="margin-left:0.5rem;">💾 Guardar notas</button>
      </div>
      <% if (actividadActual.tipo === 'repertorio') { %>
      <div style="margin-top:0.5rem;display:flex;align-items:center;justify-content:center;gap:0.5rem;flex-wrap:wrap;">
        <span style="color:rgba(255,255,255,0.85);font-size:0.95rem;">Tempo:</span>
        <input type="number" id="tempoEditar" value="<%= actividadActual.tempo || defaultBpm %>" min="20" max="300" oninput="tempoInputChanged(this.value)" style="width:80px;text-align:center;padding:0.4rem;border-radius:4px;border:none;font-size:1rem;">
        <button onclick="guardarTempoPieza()" class="btn btn-small btn-primary">💾 Guardar tempo</button>
        <span id="tempoGuardadoMsg" style="font-size:0.85rem;color:#2ecc71;display:none;">✓ Guardado</span>
      </div>
      <% } %>
    </div>
    <h2 id="timerTime">00:00:00</h2>

    <% if (actividadActual.tipo === 'tecnica_ejercicios') { %>
    <div id="controlesTecnicaEjercicios">
      <% if (ejerciciosPendientes && ejerciciosPendientes.length) { %>
      <div id="ejercicioCard" style="background:rgba(255,255,255,0.12);border-radius:8px;padding:1rem;margin:0.75rem 0;">
        <div id="ejercicioNombre" style="font-size:1.4rem;font-weight:bold;margin-bottom:0.4rem;"></div>
        <div style="font-size:1.1rem;">♩ = <span id="bpmValue"></span></div>
        <div id="ejercicioComentarios" style="font-size:0.85rem;opacity:0.7;margin-top:0.25rem;"></div>
      </div>
      <div id="ejercicioProgreso" style="margin-bottom:0.5rem;font-size:0.9rem;opacity:0.8;"></div>
      <div class="timer-controls">
        <button id="btnIniciarTecnica" class="btn btn-success" onclick="iniciarTimer()" style="<%= hayActividadesCompletadas ? 'display:none;' : '' %>"><%= hayActividadesCompletadas ? 'Reanudar' : 'Iniciar' %></button>
        <button id="btnPausarTecnica" class="btn btn-warning" onclick="pausarTimer()" style="display:none;">Pausar</button>
        <button id="btnBien"   class="btn btn-success" style="font-size:1.4rem;padding:0.65rem 1.5rem;" onclick="valorarEjercicio('bien')">👍 Bien</button>
        <button id="btnNeutro" class="btn btn-warning" style="font-size:1.4rem;padding:0.65rem 1.5rem;" onclick="valorarEjercicio('neutro')">↔️ Neutro</button>
        <button id="btnMal"    class="btn btn-danger"  style="font-size:1.4rem;padding:0.65rem 1.5rem;" onclick="valorarEjercicio('mal')">👎 Mal</button>
        <% if (!esUltimaActividad) { %><button class="btn btn-primary" onclick="siguienteActividad()">Siguiente actividad</button><% } %>
        <button class="btn btn-danger" onclick="finalizarSesion()">Finalizar sesión</button>
      </div>
      <% } else { %>
      <div class="alert alert-success" style="margin:0.75rem 0;">¡Todos los ejercicios completados!</div>
      <div class="timer-controls">
        <% if (!esUltimaActividad) { %><button class="btn btn-primary" onclick="siguienteActividad()">Siguiente actividad</button><% } %>
        <button class="btn btn-danger" onclick="finalizarSesion()">Finalizar sesión</button>
      </div>
      <% } %>
    </div>
    <% } else { %>
    <div class="timer-controls" id="controlesNormales" style="<%= actividadActual.tipo === 'repertorio' ? 'display:none;' : '' %>">
      <button id="btnIniciar" class="btn btn-success" onclick="iniciarTimer()" style="<%= hayActividadesCompletadas ? 'display:none;' : '' %>"><%= hayActividadesCompletadas ? 'Reanudar' : 'Iniciar' %></button>
      <button id="btnPausar"  class="btn btn-warning" onclick="pausarTimer()" style="display:none;">Pausar</button>
      <% if (!esUltimaActividad) { %><button id="btnSiguiente" class="btn btn-primary" onclick="siguienteActividad()">Siguiente actividad</button><% } %>
      <button id="btnFinalizar" class="btn btn-danger" onclick="finalizarSesion()">Finalizar sesión</button>
    </div>
    <% } %>

    <div class="timer-controls" id="controlesRepertorio" style="<%= actividadActual.tipo !== 'repertorio' ? 'display:none;' : '' %>">
      <button id="btnIniciarRep" class="btn btn-success" onclick="iniciarTimer()" style="<%= hayActividadesCompletadas ? 'display:none;' : '' %>"><%= hayActividadesCompletadas ? 'Reanudar' : 'Iniciar' %></button>
      <button id="btnPausarRep"  class="btn btn-warning" onclick="pausarTimer()" style="display:none;">Pausar</button>
      <button id="btnCompletarPieza" class="btn btn-primary" onclick="completarPieza()">✓ Pieza completada — Siguiente</button>
      <% if (!esUltimaActividad) { %><button id="btnTerminarRepertorio" class="btn btn-warning" onclick="terminarRepertorio()">Terminar Repertorio</button><% } %>
      <button id="btnFinalizarRep" class="btn btn-danger" onclick="finalizarSesion()">Finalizar sesión</button>
    </div>

    <% if (actividadActual.tipo === 'repertorio') { %>
    <div class="mt-1">
      <label for="fallos" style="color:white;font-size:1.1rem;">Fallos en esta pieza:</label>
      <input type="number" id="fallos" min="0" value="0" style="width:120px;text-align:center;font-size:1.5rem;padding:0.5rem;">
      <input type="hidden" id="piezaEstado" value="<%= actividadActual.pieza_estado || 'aprendizaje' %>">
      <div style="margin-top:0.5rem;font-size:0.9rem;opacity:0.8;">
        <span id="piezasTocadas">Piezas completadas: 0</span>
      </div>
    </div>

    <div style="margin-top:0.6rem;background:rgba(255,255,255,0.1);border-radius:8px;padding:0.6rem 0.7rem;text-align:left;">
      <div style="text-align:center;color:rgba(255,255,255,0.85);font-size:0.85rem;margin-bottom:0.3rem;">🎛️ Tono en el Roland</div>
      <%- include('partials/tone_picker', {
        idPrefix: 'sesionTonePicker', fieldPrefix: 'sesionTono',
        initial: tonoActual || {},
        onSelectJs: "midiSelectToneFromPicker(t);"
      }) %>
      <div style="text-align:center;margin-top:0.3rem;">
        <button onclick="guardarTono()" class="btn btn-small btn-primary">💾 Guardar tono para esta pieza</button>
        <span id="tonoGuardadoMsg" style="font-size:0.85rem;color:#2ecc71;display:none;margin-left:0.5rem;">✓ Guardado</span>
      </div>
    </div>
    <% } %>

    <!-- Metrónomo -->
    <div class="metronome-widget">
      <div id="midiDeviceRow" style="display:none;margin-bottom:0.75rem;padding-bottom:0.75rem;border-bottom:1px solid rgba(255,255,255,0.2);">
        <div class="metro-control-label" style="margin-bottom:0.4rem;">Puerto MIDI</div>
        <div style="display:flex;align-items:center;justify-content:center;gap:0.5rem;flex-wrap:wrap;">
          <select id="midiOutputSelect" onchange="midiSelectOutput(this.value)" style="padding:0.4rem 0.5rem;border-radius:6px;border:none;font-size:0.85rem;max-width:200px;">
            <option value="">— Salida (Roland) —</option>
          </select>
          <select id="midiInputSelect" onchange="midiSelectInput(this.value)" style="padding:0.4rem 0.5rem;border-radius:6px;border:none;font-size:0.85rem;max-width:200px;">
            <option value="">— Entrada (teclado) —</option>
          </select>
          <span id="midiStatus" style="font-size:0.8rem;color:rgba(255,255,255,0.6);"></span>
        </div>
        <div style="text-align:center;margin-top:0.3rem;display:flex;align-items:center;justify-content:center;gap:0.75rem;">
          <span id="midiThruStatus" style="font-size:0.8rem;color:rgba(255,255,255,0.45);">⚡ Modo Dual: inactivo</span>
        </div>
        <div id="midiErrorArea" style="display:none;margin-top:0.5rem;text-align:center;">
          <p id="midiErrorText" style="font-size:0.82rem;color:#f1948a;margin-bottom:0.4rem;"></p>
          <button class="btn-metro" onclick="midiRetry()" style="font-size:0.82rem;padding:0.35rem 0.9rem;">Reintentar conexión</button>
        </div>
      </div>
      <h3>♩ Metrónomo</h3>
      <div class="metro-controls-row">
        <div class="metro-control-group">
          <div class="metro-control-label">BPM</div>
          <div class="metro-btn-row">
            <button class="btn-metro" onclick="metronomeChangeBpm(-5)">-5</button>
            <button class="btn-metro" onclick="metronomeChangeBpm(-1)">-1</button>
            <span id="metronomeBpmDisplay" class="metro-value"><%= defaultBpm %></span>
            <button class="btn-metro" onclick="metronomeChangeBpm(+1)">+1</button>
            <button class="btn-metro" onclick="metronomeChangeBpm(+5)">+5</button>
          </div>
        </div>
        <div class="metro-control-group">
          <div class="metro-control-label">Pulsos/compás</div>
          <div class="metro-btn-row">
            <button class="btn-metro" onclick="metronomeChangeBeats(-1)">−</button>
            <span id="metronomeBeatsDisplay" class="metro-beats-value">4</span>
            <button class="btn-metro" onclick="metronomeChangeBeats(+1)">+</button>
          </div>
        </div>
      </div>
      <div class="metro-beats-visual" id="metronomeBeatsVisual"></div>
      <div style="display:flex;align-items:center;justify-content:center;margin-bottom:0.6rem;">
        <button id="metronomeAccentBtn" class="btn-metro" onclick="metronomeToggleAccent()" style="padding:0.3rem 0.9rem;font-size:0.85rem;">
          Acento 1er pulso: <strong id="metronomeAccentLabel">ON</strong>
        </button>
      </div>
      <div style="display:flex;align-items:center;justify-content:center;gap:0.6rem;margin-bottom:0.75rem;">
        <span>🔇</span>
        <input type="range" id="metronomeVolSlider" min="0" max="100" value="70" oninput="metronomeSetVolume(this.value)" style="width:130px;accent-color:#f39c12;cursor:pointer;">
        <span>🔊</span>
        <span id="metronomeVolDisplay" style="color:white;font-size:0.85rem;min-width:2.5rem;">70%</span>
      </div>
      <button id="metronomeBtnToggle" class="btn btn-success" onclick="metronomeToggle()">▶ Iniciar metrónomo</button>
    </div>
  </div>

  <input type="hidden" id="sesionId"    value="<%= sesion.id %>">
  <input type="hidden" id="actividadId" value="<%= actividadActual.id %>">
  <input type="hidden" id="piezaId"     value="<%= actividadActual.pieza_id || '' %>">
  <input type="hidden" id="tiempoInicial" value="<%= actividadActual.tiempo_segundos %>">
  <input type="hidden" id="esUltimaActividad" value="<%= esUltimaActividad ? '1' : '0' %>">
  <% } else { %>
  <div class="alert alert-success">
    <strong>¡Sesión completada!</strong> Todas las actividades han sido finalizadas.
    <br><a href="/sesion" class="btn btn-primary btn-small mt-1">Nueva sesión</a>
  </div>
  <% } %>
</div>

<div class="card">
  <h2>Actividades de la sesión</h2>
  <ul class="actividades-lista">
  <% actividades.forEach(act => { %>
    <li class="actividad-item <%= act.estado === 'en_curso' ? 'activa' : (act.estado === 'completada' ? 'completada' : '') %>">
      <div class="actividad-info">
        <strong><%= h.getNombreActividad(act.tipo) %></strong>
        <% if (act.compositor) { %><small><%= act.compositor %> — <%= act.titulo %><% if (act.tempo) { %> (♩ = <%= act.tempo %>)<% } %></small><% } %>
        <% if (act.notas) { %><small><%- act.notas.replace(/\n/g,'<br>') %></small><% } %>
      </div>
      <div class="actividad-tiempo"><%= h.formatearTiempo(act.tiempo_segundos) %></div>
      <div><%= act.estado.charAt(0).toUpperCase() + act.estado.slice(1) %></div>
    </li>
  <% }) %>
  </ul>
</div>

<% if (piezasPracticadas && piezasPracticadas.length) { %>
<div class="card">
  <h2>🎹 Piezas practicadas en esta sesión</h2>
  <table>
    <thead><tr><th>Pieza</th><th>Fallos</th><th>Hora</th></tr></thead>
    <tbody>
    <% piezasPracticadas.forEach(pp => { %>
      <tr>
        <td><strong><%= pp.compositor %> — <%= pp.titulo %></strong></td>
        <td style="text-align:center;">
          <span style="color:<%= pp.fallos < 5 ? '#27ae60' : (pp.fallos < 10 ? '#f39c12' : '#e74c3c') %>;font-weight:bold;"><%= pp.fallos %></span>
        </td>
        <td><%= pp.hora || '' %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<!-- ══════════════════════════ PLANIFICACIÓN ══════════════════════════ -->
<% } else { %>
<div class="card">
  <h2>Planificar nueva sesión</h2>
  <% if (ultimaSesion) { %>
  <div class="alert alert-info" style="margin-bottom:1rem;">
    ℹ️ <strong>Configuración precargada</strong> de la última sesión (<%= h.formatDate(ultimaSesion.fecha) %>). Puedes modificar, añadir o eliminar actividades.
  </div>
  <% } %>
  <form method="POST" action="/sesion" id="formPlanificacion">
    <input type="hidden" name="crear_sesion" value="1">
    <div id="actividadesContainer">
      <% ultimasActividades.forEach((act, index) => { %>
      <div class="actividad-item">
        <div class="actividad-info">
          <strong><%= h.getNombreActividad(act.tipo) %></strong>
          <% if (act.notas) { %><small><%= act.notas %></small><% } %>
          <input type="hidden" name="actividades[<%= index %>][tipo]"  value="<%= act.tipo %>">
          <input type="hidden" name="actividades[<%= index %>][notas]" value="<%= act.notas || '' %>">
        </div>
        <button type="button" class="btn btn-danger btn-small" onclick="this.parentElement.remove()">Eliminar</button>
      </div>
      <% }) %>
    </div>
    <div class="form-inline">
      <div class="form-group">
        <label for="tipoActividad">Tipo de actividad</label>
        <select id="tipoActividad">
          <option value="calentamiento">Calentamiento</option>
          <option value="tecnica_ejercicios">Técnica</option>
          <option value="practica_tecnica">Práctica de técnica</option>
          <option value="practica">Práctica de repertorio</option>
          <option value="repertorio">Repertorio</option>
          <option value="improvisacion">Improvisación</option>
          <option value="composicion">Composición</option>
        </select>
      </div>
      <div class="form-group">
        <label for="notasActividadNueva">Notas (opcional)</label>
        <input type="text" id="notasActividadNueva" placeholder="Ej: Escalas en Do Mayor">
      </div>
      <div class="form-group">
        <button type="button" class="btn btn-primary" onclick="agregarActividad()">Añadir</button>
      </div>
    </div>
    <div class="mt-2">
      <button type="submit" name="iniciar_ahora" value="1" class="btn btn-success">▶️ Comenzar sesión ahora</button>
      <button type="submit" class="btn btn-primary">📅 Preparar para después</button>
    </div>
  </form>
</div>
<% } %>

<script src="/assets/js/midi-roland.js"></script>
<script>
let actividadesCount = <%= ultimasActividades ? ultimasActividades.length : 0 %>;

function agregarActividad() {
  const tipo = document.getElementById('tipoActividad').value;
  const notas = document.getElementById('notasActividadNueva').value;
  const tipoNombre = document.getElementById('tipoActividad').options[document.getElementById('tipoActividad').selectedIndex].text;
  const container = document.getElementById('actividadesContainer');
  const div = document.createElement('div');
  div.className = 'actividad-item';
  div.innerHTML = `<div class="actividad-info"><strong>${tipoNombre}</strong>${notas ? '<small>' + notas + '</small>' : ''}<input type="hidden" name="actividades[${actividadesCount}][tipo]" value="${tipo}"><input type="hidden" name="actividades[${actividadesCount}][notas]" value="${notas}"></div><button type="button" class="btn btn-danger btn-small" onclick="this.parentElement.remove()">Eliminar</button>`;
  container.appendChild(div);
  actividadesCount++;
  document.getElementById('notasActividadNueva').value = '';
}

<% if (sesion && actividadActual) { %>
let timerInterval = null, tiempoActual = 0, timerActivo = false, piezasCompletadas = 0;
let tonoSeleccionadoActual = <%- tonoActual ? JSON.stringify(tonoActual) : 'null' %>;
tiempoActual = parseInt(document.getElementById('tiempoInicial').value) || 0;
actualizarDisplay();
piezasCompletadas = <%= piezasYaCompletadas %>;
if (document.getElementById('piezasTocadas')) document.getElementById('piezasTocadas').textContent = 'Piezas completadas: ' + piezasCompletadas;

function obtenerTipoPasada() {
  const estado = document.getElementById('piezaEstado')?.value || 'aprendizaje';
  return estado === 'mantenimiento' ? 'libre' : 'metronomo';
}

function fijarTipoPasadaPorEstado(estadoPieza) {
  const input = document.getElementById('piezaEstado');
  if (input) input.value = estadoPieza;
}

function midiSelectToneFromPicker(t) {
  tonoSeleccionadoActual = t;
  rolandSelectTone(midiOutput, t);
}

<% if (hayActividadesCompletadas && actividadActual.tipo !== 'tecnica_ejercicios') { %>
setTimeout(() => iniciarTimer(), 500);
<% } %>

<% if (actividadActual.tipo === 'tecnica_ejercicios' && ejerciciosPendientes && ejerciciosPendientes.length) { %>
// === TÉCNICA: EJERCICIOS ===
const ejerciciosTecnica = <%- JSON.stringify(ejerciciosPendientes) %>;
const totalEjerciciosTecnica = <%= totalEjercicios %>;
let ejercicioActualIdx = 0;
let intentosMalSeguidos = 0;
const TOPE_INTENTOS_MAL = 2;
const ejerciciosHechosInicio = <%= ejerciciosHechos %>;

function mostrarEjercicioActual() {
  if (ejercicioActualIdx >= ejerciciosTecnica.length) return;
  const ej = ejerciciosTecnica[ejercicioActualIdx];
  document.getElementById('ejercicioNombre').textContent = ej.nombre;
  document.getElementById('bpmValue').textContent = ej.bpm;
  document.getElementById('ejercicioComentarios').textContent = ej.comentarios || '';
  const posicion = ejerciciosHechosInicio + ejercicioActualIdx + 1;
  document.getElementById('ejercicioProgreso').textContent = posicion + ' / ' + totalEjerciciosTecnica;
  metronomeSetBpm(parseInt(ej.bpm));
  document.getElementById('btnBien').disabled   = false;
  document.getElementById('btnNeutro').disabled = false;
  document.getElementById('btnMal').disabled    = false;
}

function valorarEjercicio(resultado) {
  const ej = ejerciciosTecnica[ejercicioActualIdx];
  document.getElementById('btnBien').disabled   = true;
  document.getElementById('btnNeutro').disabled = true;
  document.getElementById('btnMal').disabled    = true;

  fetch('/sesion', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
    body: JSON.stringify({ accion: 'ejercicio_valorar', actividad_id: document.getElementById('actividadId').value, ejercicio_id: ej.id, resultado, bpm_actual: parseInt(ej.bpm) })
  })
  .then(r => r.json())
  .then(data => {
    if (!data.success) {
      document.getElementById('btnBien').disabled   = false;
      document.getElementById('btnNeutro').disabled = false;
      document.getElementById('btnMal').disabled    = false;
      alert('Error: ' + (data.error || 'desconocido'));
      return;
    }
    ejerciciosTecnica[ejercicioActualIdx].bpm = data.nuevo_bpm;

    // Tope de reintentos: si sale "mal", se repite el mismo ejercicio hasta
    // TOPE_INTENTOS_MAL veces seguidas antes de pasar al siguiente, para no
    // dejar de rotar el resto de ejercicios por uno atascado.
    if (resultado === 'mal') intentosMalSeguidos++; else intentosMalSeguidos = 0;
    if (resultado !== 'mal' || intentosMalSeguidos >= TOPE_INTENTOS_MAL) {
      intentosMalSeguidos = 0;
      ejercicioActualIdx++;
    }

    if (ejercicioActualIdx >= ejerciciosTecnica.length) {
      if (timerActivo) pausarTimer();
      fetch('/sesion', {
        method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ accion: 'siguiente', actividad_id: document.getElementById('actividadId').value, tiempo: tiempoActual, pieza_id: null, fallos: 0 })
      })
      .then(r => r.json())
      .then(data => { if (data.success) { if (data.hay_siguiente) location.reload(); else finalizarSesionInterno(true); } });
    } else {
      mostrarEjercicioActual();
    }
  })
  .catch(() => {
    document.getElementById('btnBien').disabled   = false;
    document.getElementById('btnNeutro').disabled = false;
    document.getElementById('btnMal').disabled    = false;
  });
}

setTimeout(() => {
  mostrarEjercicioActual();
  <% if (hayActividadesCompletadas) { %>iniciarTimer();<% } %>
}, 0);
<% } %>

function iniciarTimer() {
  if (timerActivo) return;
  timerActivo = true;
  const { btnIniciar, btnPausar } = getBotonesTimer();
  if (btnIniciar) btnIniciar.style.display = 'none';
  if (btnPausar)  btnPausar.style.display  = 'inline-block';
  <% if (actividadActual.tipo === 'repertorio') { %>
  if (tonoSeleccionadoActual) rolandSelectTone(midiOutput, tonoSeleccionadoActual);
  <% } %>
  fetch('/sesion', { method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'}, body:JSON.stringify({ accion:'iniciar', actividad_id: document.getElementById('actividadId').value }) });
  timerInterval = setInterval(() => {
    tiempoActual++;
    actualizarDisplay();
    if (tiempoActual % 5 === 0) guardarTiempo();
  }, 1000);
}

function pausarTimer() {
  if (!timerActivo) return;
  timerActivo = false;
  const { btnIniciar, btnPausar } = getBotonesTimer();
  if (btnIniciar) { btnIniciar.textContent = 'Reanudar'; btnIniciar.style.display = 'inline-block'; }
  if (btnPausar)    btnPausar.style.display = 'none';
  clearInterval(timerInterval);
  guardarTiempo();
}

function getBotonesTimer() {
  if (document.getElementById('btnPausarTecnica')) {
    return { btnIniciar: document.getElementById('btnIniciarTecnica'), btnPausar: document.getElementById('btnPausarTecnica') };
  }
  const esRep = document.getElementById('controlesRepertorio').style.display !== 'none';
  return { btnIniciar: esRep ? document.getElementById('btnIniciarRep') : document.getElementById('btnIniciar'), btnPausar: esRep ? document.getElementById('btnPausarRep') : document.getElementById('btnPausar') };
}

function guardarTiempo() {
  fetch('/sesion', { method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'}, body:JSON.stringify({ accion:'guardar', actividad_id: document.getElementById('actividadId').value, tiempo: tiempoActual }) });
}

function guardarNotas() {
  const notas = document.getElementById('notasActividad').value;
  fetch('/sesion', { method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'}, body:JSON.stringify({ accion:'guardar_notas', actividad_id: document.getElementById('actividadId').value, notas }) })
    .then(r => r.json()).then(d => { if (d.success) { const n = document.getElementById('notasActuales'); if (n) n.textContent = notas; } else alert('Error al guardar notas'); });
}

function completarPieza() {
  const fallos = document.getElementById('fallos')?.value || 0;
  const piezaId = document.getElementById('piezaId').value;
  if (!piezaId) { alert('No hay pieza seleccionada'); return; }
  confirmar('¿Marcar esta pieza como completada y cargar la siguiente?', function() {
  guardarTiempo();
  fetch('/sesion', { method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'}, body:JSON.stringify({ accion:'completar_pieza', actividad_id: document.getElementById('actividadId').value, pieza_id: piezaId, fallos: parseInt(fallos), tiempo: tiempoActual, tipo_pasada: obtenerTipoPasada() }) })
    .then(r => r.json()).then(data => {
      if (data.success && data.siguiente_pieza) {
        document.getElementById('piezaId').value = data.siguiente_pieza.id;
        let txt = '<br><small>' + data.siguiente_pieza.compositor + ' — ' + data.siguiente_pieza.titulo;
        if (data.siguiente_pieza.tempo) txt += ' (♩ = ' + data.siguiente_pieza.tempo + ')';
        txt += '</small>';
        document.getElementById('piezaActualInfo').innerHTML = txt;
        document.getElementById('fallos').value = 0;
        fijarTipoPasadaPorEstado(data.siguiente_pieza.estado);
        const tempoI = document.getElementById('tempoEditar');
        if (tempoI) tempoI.value = data.siguiente_pieza.tempo || '';
        if (data.siguiente_pieza.tempo) metronomeSetBpm(data.siguiente_pieza.tempo);
        if (data.siguiente_pieza.tono) {
          tonoSeleccionadoActual = data.siguiente_pieza.tono;
          rolandSelectTone(midiOutput, tonoSeleccionadoActual);
        }
        piezasCompletadas++;
        document.getElementById('piezasTocadas').textContent = 'Piezas completadas: ' + piezasCompletadas;
        if (data.cambio_nivel) mostrarAvisoNivel(data.cambio_nivel);
      } else if (data.success && !data.siguiente_pieza) {
        document.getElementById('piezaId').value = '';
        document.getElementById('fallos').value = 0;
        const continuar = () => { alert('¡Has completado todas las piezas disponibles para esta sesión!'); terminarRepertorio(); };
        if (data.cambio_nivel) mostrarAvisoNivel(data.cambio_nivel, continuar); else continuar();
      } else { alert('Error: ' + (data.error || 'No se pudo cargar la siguiente pieza')); }
    });
  });
}

function terminarRepertorio() {
  confirmar('¿Finalizar la actividad de Repertorio y pasar a la siguiente?', function() {
  const piezaId = document.getElementById('piezaId').value;
  const fallos  = piezaId ? (document.getElementById('fallos')?.value || 0) : 0;
  if (timerActivo) pausarTimer();
  fetch('/sesion', { method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'}, body:JSON.stringify({ accion:'terminar_repertorio', actividad_id: document.getElementById('actividadId').value, tiempo: tiempoActual, pieza_id: piezaId, fallos: parseInt(fallos), tipo_pasada: obtenerTipoPasada() }) })
    .then(r => r.json()).then(d => {
      if (d.success) {
        const continuar = () => {
          if (d.hay_siguiente) location.reload();
          else { document.getElementById('piezaId').value = ''; document.getElementById('fallos').value = 0; finalizarSesionInterno(true); }
        };
        if (d.cambio_nivel) mostrarAvisoNivel(d.cambio_nivel, continuar); else continuar();
      }
    });
  });
}

function siguienteActividad() {
  confirmar('¿Pasar a la siguiente actividad? Se guardará el progreso actual.', function() {
  if (timerActivo) pausarTimer();
  const piezaId = document.getElementById('piezaId').value;
  const fallos  = piezaId ? (document.getElementById('fallos')?.value || 0) : 0;
  fetch('/sesion', { method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'}, body:JSON.stringify({ accion:'siguiente', actividad_id: document.getElementById('actividadId').value, tiempo: tiempoActual, pieza_id: piezaId, fallos, tipo_pasada: obtenerTipoPasada() }) })
    .then(r => r.json()).then(d => {
      if (d.success) {
        const continuar = () => {
          if (d.hay_siguiente) location.reload();
          else { document.getElementById('piezaId').value = ''; if (document.getElementById('fallos')) document.getElementById('fallos').value = 0; finalizarSesionInterno(true); }
        };
        if (d.cambio_nivel) mostrarAvisoNivel(d.cambio_nivel, continuar); else continuar();
      }
    });
  });
}

function finalizarSesion() {
  confirmar('¿Finalizar la sesión? Esto guardará todo el progreso.', function() {
    finalizarSesionInterno(false);
  });
}

function finalizarSesionInterno(auto) {
  if (timerActivo) pausarTimer();
  const piezaId = document.getElementById('piezaId').value;
  const fallos  = piezaId ? (document.getElementById('fallos')?.value || 0) : 0;
  fetch('/sesion', { method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'}, body:JSON.stringify({ accion:'finalizar', sesion_id: document.getElementById('sesionId').value, actividad_id: document.getElementById('actividadId').value, tiempo: tiempoActual, pieza_id: piezaId, fallos, tipo_pasada: obtenerTipoPasada() }) })
    .then(r => r.json()).then(d => {
      if (d.success) {
        const continuar = () => { if (auto) alert('✓ ¡Sesión completada!'); location.reload(); };
        if (d.cambio_nivel) mostrarAvisoNivel(d.cambio_nivel, continuar); else continuar();
      }
    });
}

function actualizarDisplay() {
  const h2 = Math.floor(tiempoActual/3600), m2 = Math.floor((tiempoActual%3600)/60), s2 = tiempoActual%60;
  document.getElementById('timerTime').textContent = String(h2).padStart(2,'0')+':'+String(m2).padStart(2,'0')+':'+String(s2).padStart(2,'0');
}

function guardarTempoPieza() {
  const tempoI=document.getElementById('tempoEditar'), piezaId=document.getElementById('piezaId').value;
  if (!tempoI||!piezaId) return;
  const tempo=parseInt(tempoI.value);
  if (!tempo||tempo<20||tempo>300) return;
  fetch('/sesion',{method:'POST',headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},body:JSON.stringify({accion:'guardar_tempo',pieza_id:piezaId,tempo})})
    .then(r=>r.json()).then(d=>{if(d.success){const m=document.getElementById('tempoGuardadoMsg');if(m){m.style.display='inline';setTimeout(()=>{m.style.display='none';},2000);}}else alert('Error:'+d.error);});
}

function tempoInputChanged(v) { const b=parseInt(v); if (b>=20&&b<=300) metronomeSetBpm(b); }

function guardarTono() {
  const piezaId = document.getElementById('piezaId').value;
  if (!piezaId || !tonoSeleccionadoActual) { alert('Selecciona antes un tono en la lista.'); return; }
  fetch('/sesion', { method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'}, body:JSON.stringify({
    accion:'guardar_tono', pieza_id: piezaId,
    tono_msb: tonoSeleccionadoActual.msb, tono_lsb: tonoSeleccionadoActual.lsb, tono_pc: tonoSeleccionadoActual.pc, tono_nombre: tonoSeleccionadoActual.name || tonoSeleccionadoActual.nombre
  }) })
  .then(r=>r.json()).then(d=>{
    if (d.success) { const m=document.getElementById('tonoGuardadoMsg'); if (m){m.style.display='inline';setTimeout(()=>{m.style.display='none';},2000);} }
    else alert('Error al guardar el tono: '+d.error);
  });
}

// === METRÓNOMO ===
const METRO_LOOKAHEAD = 0.1, METRO_INTERVAL = 25;
let metronomeBpm = <%= defaultBpm %>, metronomeBeats = 4, metronomeRunning = false, metronomeCurBeat = 0, metronomeNextTime = 0, metronomeTimer = null, metronomeAudioCtx = null;
let metronomeVolume = parseFloat(localStorage.getItem('metro_volumen') || '0.7');
let metronomeAccent = localStorage.getItem('metro_acento') !== 'false';

function metronomePlayClick(time, isFirst) {
  const osc=metronomeAudioCtx.createOscillator(), gain=metronomeAudioCtx.createGain();
  osc.connect(gain); gain.connect(metronomeAudioCtx.destination);
  osc.frequency.value = (isFirst && metronomeAccent) ? 880 : 440;
  gain.gain.setValueAtTime(metronomeVolume, time);
  gain.gain.exponentialRampToValueAtTime(0.001, time+0.06);
  osc.start(time); osc.stop(time+0.06);
}
function metronomeSchedule() {
  while (metronomeNextTime < metronomeAudioCtx.currentTime+METRO_LOOKAHEAD) {
    const beat=metronomeCurBeat, t=metronomeNextTime;
    metronomePlayClick(t, beat===0);
    const delay=Math.max(0,(t-metronomeAudioCtx.currentTime)*1000);
    setTimeout(() => metronomeSetActiveBeat(beat), delay);
    metronomeCurBeat=(metronomeCurBeat+1)%metronomeBeats;
    metronomeNextTime+=60.0/metronomeBpm;
  }
  metronomeTimer=setTimeout(metronomeSchedule, METRO_INTERVAL);
}
async function metronomeStart() {
  if (!metronomeAudioCtx) metronomeAudioCtx = new (window.AudioContext||window.webkitAudioContext)();
  if (metronomeAudioCtx.state === 'suspended') await metronomeAudioCtx.resume();
  metronomeCurBeat=0; metronomeNextTime=metronomeAudioCtx.currentTime+0.05;
  metronomeSchedule(); metronomeRunning=true;
  const btn=document.getElementById('metronomeBtnToggle');
  btn.textContent='⏹ Parar metrónomo'; btn.classList.remove('btn-success'); btn.classList.add('btn-warning');
}
function metronomeStop() {
  clearTimeout(metronomeTimer); metronomeRunning=false; metronomeCurBeat=0;
  const btn=document.getElementById('metronomeBtnToggle');
  btn.textContent='▶ Iniciar metrónomo'; btn.classList.remove('btn-warning'); btn.classList.add('btn-success');
  metronomeSetActiveBeat(-1);
}
function metronomeToggle() { if (metronomeRunning) metronomeStop(); else metronomeStart(); }
function metronomeChangeBpm(d) { metronomeBpm=Math.max(20,Math.min(300,metronomeBpm+d)); document.getElementById('metronomeBpmDisplay').textContent=metronomeBpm; if (metronomeRunning){metronomeStop();metronomeStart();} }
function metronomeSetBpm(b) { metronomeBpm=Math.max(20,Math.min(300,parseInt(b)||92)); document.getElementById('metronomeBpmDisplay').textContent=metronomeBpm; if (metronomeRunning){metronomeStop();metronomeStart();} }
function metronomeChangeBeats(d) { metronomeBeats=Math.max(1,Math.min(12,metronomeBeats+d)); document.getElementById('metronomeBeatsDisplay').textContent=metronomeBeats; metronomeBuildDots(); if (metronomeRunning){metronomeStop();metronomeStart();} }
function metronomeSetActiveBeat(active) {
  document.querySelectorAll('.metro-beat-dot').forEach((dot,i) => {
    dot.className='metro-beat-dot'; if (i===0) dot.classList.add('first-idle');
    if (i===active) { dot.classList.remove('first-idle'); dot.classList.add(i===0?'active-first':'active'); }
  });
}
function metronomeBuildDots() {
  const c=document.getElementById('metronomeBeatsVisual'); c.innerHTML='';
  for (let i=0;i<metronomeBeats;i++) { const d=document.createElement('span'); d.className='metro-beat-dot'+(i===0?' first-idle':''); c.appendChild(d); }
}
metronomeBuildDots();
(function(){
  const pct2=Math.round(metronomeVolume*100);
  document.getElementById('metronomeVolSlider').value=pct2;
  document.getElementById('metronomeVolDisplay').textContent=pct2+'%';
  document.getElementById('metronomeAccentLabel').textContent=metronomeAccent?'ON':'OFF';
  document.getElementById('metronomeAccentBtn').style.opacity=metronomeAccent?'1':'0.5';
})();
function metronomeSetVolume(v) { metronomeVolume=parseInt(v)/100; localStorage.setItem('metro_volumen',metronomeVolume.toString()); document.getElementById('metronomeVolDisplay').textContent=v+'%'; }
function metronomeToggleAccent() { metronomeAccent=!metronomeAccent; localStorage.setItem('metro_acento',metronomeAccent.toString()); document.getElementById('metronomeAccentLabel').textContent=metronomeAccent?'ON':'OFF'; document.getElementById('metronomeAccentBtn').style.opacity=metronomeAccent?'1':'0.5'; }

// === MIDI ===
let midiAccess=null, midiOutput=null, midiInput=null;
async function midiInit() {
  if (!navigator.requestMIDIAccess) return;
  const row=document.getElementById('midiDeviceRow'), errArea=document.getElementById('midiErrorArea'), sel=document.getElementById('midiOutputSelect'), status=document.getElementById('midiStatus');
  row.style.display='block'; errArea.style.display='none'; sel.style.display=''; status.style.display=''; status.textContent='Conectando...';
  try {
    midiAccess=await navigator.requestMIDIAccess({ sysex: true });
    midiPopulateOutputs(); midiPopulateInputs();
    midiAccess.onstatechange=()=>{midiPopulateOutputs();midiPopulateInputs();};
  } catch(e) {
    sel.style.display='none'; const inS=document.getElementById('midiInputSelect'); if(inS) inS.style.display='none';
    status.style.display='none'; errArea.style.display='block';
    document.getElementById('midiErrorText').textContent='MIDI no disponible: '+(e.message||e.name);
  }
}
async function midiRetry() { midiAccess=null; midiOutput=null; midiInput=null; await midiInit(); }
function midiPopulateOutputs() {
  const sel=document.getElementById('midiOutputSelect'), savedId=localStorage.getItem('midi_output_id');
  sel.innerHTML='<option value="">— Sin dispositivo —</option>'; midiOutput=null;
  midiAccess.outputs.forEach(out=>{ const opt=document.createElement('option'); opt.value=out.id; opt.textContent=out.name; if(out.id===savedId){opt.selected=true;midiOutput=out;} sel.appendChild(opt); });
  const status=document.getElementById('midiStatus');
  if(midiOutput){status.textContent='✓ Conectado';status.style.color='#2ecc71';}
  else{status.textContent=midiAccess.outputs.size>0?'Selecciona dispositivo':'Sin dispositivos';status.style.color='rgba(255,255,255,0.6)';}
  midiSetupThru();
}
function midiSelectOutput(id) {
  localStorage.setItem('midi_output_id',id); midiOutput=id?midiAccess.outputs.get(id):null;
  const s=document.getElementById('midiStatus'); if(midiOutput){s.textContent='✓ Conectado';s.style.color='#2ecc71';}else{s.textContent='Sin dispositivo';s.style.color='rgba(255,255,255,0.6)';} midiSetupThru();
}
function midiPopulateInputs() {
  const sel=document.getElementById('midiInputSelect'); if(!sel||!midiAccess) return;
  const savedId=localStorage.getItem('midi_input_id'); sel.innerHTML='<option value="">— Entrada —</option>'; midiInput=null;
  midiAccess.inputs.forEach(inp=>{ const opt=document.createElement('option'); opt.value=inp.id; opt.textContent=inp.name; if(inp.id===savedId){opt.selected=true;midiInput=inp;} sel.appendChild(opt); });
  midiSetupThru();
}
function midiSelectInput(id) { localStorage.setItem('midi_input_id',id); midiInput=id?midiAccess.inputs.get(id):null; midiSetupThru(); }
function midiSetupThru() {
  if(midiAccess) midiAccess.inputs.forEach(i=>{i.onmidimessage=null;});
  const statusEl=document.getElementById('midiThruStatus');
  if(midiInput&&midiOutput){
    midiInput.onmidimessage=(ev)=>{if(midiOutput)midiOutput.send(ev.data);};
    if(statusEl){statusEl.textContent='⚡ Modo Dual: activo';statusEl.style.color='#2ecc71';}
  } else { if(statusEl){statusEl.textContent='⚡ Modo Dual: inactivo';statusEl.style.color='rgba(255,255,255,0.45)';} }
}
<% if (actividadActual && actividadActual.tipo === 'repertorio') { %>midiInit();<% } %>
<% } /* fin if sesion */ %>
</script>

